{
  "openapi": "3.0.3",
  "info": {
    "title": "AJRM Marine Instruments API",
    "version": "0.8.1"
  },
  "paths": {
    "/status": {
      "get": {
        "summary": "Return the current instrument state and display controls",
        "responses": {
          "200": {
            "description": "Current instrument state",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/alerts/status": {
      "get": {
        "summary": "Return integrated instrument-alert and depth-callout status",
        "responses": { "200": { "description": "Current alert status" } }
      }
    },
    "/alerts/settings": {
      "get": {
        "summary": "Return integrated instrument-alert settings",
        "responses": { "200": { "description": "Active settings" } }
      },
      "put": {
        "summary": "Replace and persist integrated instrument-alert settings",
        "security": [{ "signalk": ["readwrite"] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Saved settings" },
          "403": { "description": "Read/write access required" }
        }
      }
    },
    "/alerts/depth-callout/drop": {
      "post": {
        "summary": "Announce anchor drop and request the Traffic anchor profile",
        "security": [{ "signalk": ["readwrite"] }],
        "responses": {
          "200": { "description": "Anchor drop recorded" },
          "403": { "description": "Read/write access required" },
          "409": { "description": "No recent depth available" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "signalk": { "type": "http", "scheme": "bearer" }
    }
  }
}
